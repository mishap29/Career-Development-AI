{
  "app": {
    "description": "Configuration for Career Development AI application."
  },
  "llm": {
    "default_model": "gpt-4",
    "available_models": ["gpt-4", "gpt-3.5-turbo", "claude-3-opus"],
    "temperature": 0.7,
    "max_tokens": 1024
  },
  "resume": {
    "default_template": "modern_template.jpg",
    "template_dir": "assets/resume_templates"
  },
  "text_to_image": {
    "default_model": "runwayml/stable-diffusion-v1-5"
  },
  "features": {
    "enable_job_matching": true,
    "enable_rag": true,
    "enable_persona_advice": true
  }
} 